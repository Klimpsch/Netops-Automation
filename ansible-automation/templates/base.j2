!
! {{ inventory_hostname }} - generated by Ansible, do not edit by hand
!
{% if device_type == 'switch' and vlans is defined %}
{% for vlan in vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
!
{% endfor %}
{% endif %}
{% if device_type == 'switch' %}
ip routing
!
{% endif %}
{% if loopback is defined %}
interface {{ loopback.name }}
 ip address {{ loopback.ip }} {{ loopback.mask }}
!
{% endif %}
{% for intf in interfaces %}
interface {{ intf.name }}
{% if intf.description is defined %}
 description {{ intf.description }}
{% endif %}
{% if intf.mode == 'routed' %}
{% if device_type == 'switch' %}
 no switchport
{% endif %}
 ip address {{ intf.ip }} {{ intf.mask }}
{% if intf.ospf is defined %}
 ip ospf {{ intf.ospf.process }} area {{ intf.ospf.area }}
{% endif %}
 negotiation auto
{% elif intf.mode == 'access' %}
 switchport access vlan {{ intf.access_vlan }}
 switchport mode access
 negotiation auto
{% if intf.portfast | default(false) %}
 spanning-tree portfast edge
{% endif %}
{% elif intf.mode == 'unused' %}
 no ip address
 shutdown
 negotiation auto
{% elif intf.mode == 'unused_switchport' %}
 negotiation auto
{% endif %}
!
{% endfor %}
{% if svis is defined %}
{% for svi in svis %}
interface {{ svi.name }}
{% if svi.description is defined %}
 description {{ svi.description }}
{% endif %}
 ip address {{ svi.ip }} {{ svi.mask }}
!
{% endfor %}
{% endif %}
{% if ospf is defined %}
router ospf {{ ospf.process }}
{% if ospf.router_id is defined %}
 router-id {{ ospf.router_id }}
{% endif %}
{% if ospf.passive_default | default(false) %}
 passive-interface default
{% for intf in ospf.active_interfaces %}
 no passive-interface {{ intf }}
{% endfor %}
{% endif %}
{% for net in ospf.networks %}
 network {{ net.address }} {{ net.wildcard }} area {{ net.area }}
{% endfor %}
!
{% endif %}
end
